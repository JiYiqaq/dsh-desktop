{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.2.5",
  "description": "DeepSeek Harness 桌面壳：独立窗口 + 托盘驻留 + 服务探测自愈（Electron）",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "io.dsh.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload-update.js",
      "preload-inject.js",
      "update.html",
      "update.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DeepSeekHarness-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
